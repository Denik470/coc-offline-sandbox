# Source-only local repository. Binary evidence and personal data stay outside Git.
*
!/.gitignore
!/README.md
!/STATUS.json
!/AndroidManifest.xml
!/*.py
!/src/
!/src/**
!/jni/
!/jni/*.cpp
!/coordination/
!/coordination/**
!/tests/
!/tests/**
!/parallel/
!/parallel/**
**/build/
**/dist/
**/node_modules/
**/__pycache__/
**/*.apk
**/*.idsig
**/*.so
**/*.keystore
**/*.jks
**/*.log
**/*.png
**/*.jpg
**/*.zip
**/home-canonical.json
.DS_Store

!/AGENTS.md
!/.codex/
!/.codex/**
